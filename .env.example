PORT=4000
DATABASE_PATH=/data/submissions.sqlite

# Public origin of the app (used for CORS). On the droplet this is the domain.
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Host directory that holds the SQLite database (real persistence).
# Local dev default is ./data; on the droplet use an absolute path you back up.
GACS_DATA_DIR=./data

# --- Mail: prefer Resend (HTTPS) on DigitalOcean; SMTP is blocked there ---
# Resend free tier works over api.resend.com:443. Without a verified domain,
# use onboarding@resend.dev as From and you can only send to your Resend login email.
RESEND_API_KEY=
MAIL_FROM=GACS Checker <onboarding@resend.dev>
MAIL_FROM_NAME=GACS Checker
# REPLY_TO=sales@yourcompany.com
# BCC_EMAIL=leads@yourcompany.com

# Optional local fallback (Gmail app password). Ignored when RESEND_API_KEY is set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourcompany.com
# SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Provider / acquisition CTA
PROVIDER_NAME=Example BV
CONTACT_URL=https://example.com/contact
CONTACT_EMAIL=info@example.com
CONTACT_PHONE=+31 20 000 0000
